# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
QDRANT_URL=https://your-cluster.example
QDRANT_API_KEY=replace-me
GEMINI_API_KEY=replace-me
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b
# Leave unset/default in normal environments; evaluation runs use a dedicated collection.
QDRANT_COLLECTION_NAME=pdf_knowledge_base
DOCUMENT_STORAGE_DIR=data/uploads
CONVERSATION_HISTORY_LIMIT=12
CONVERSATION_HISTORY_MAX_CHARS=12000

# Set these origins to the deployed frontend host in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_API_URL=http://127.0.0.1:8000
# /api is for local Vite proxying; production builds need the deployed backend origin.
VITE_API_BASE_URL=/api
