# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072
# Leave unset/default in normal environments; evaluation runs use a dedicated collection.
QDRANT_COLLECTION_NAME=pdf_knowledge_base
CONVERSATION_HISTORY_LIMIT=12
CONVERSATION_HISTORY_MAX_CHARS=12000
